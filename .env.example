# Fork Panel XC - Example configuration
# Copy to config/.env and adjust for your environment.

APP_NAME="Fork Panel XC"
APP_ENV=production
APP_DEBUG=false
APP_URL=http://localhost

# Database
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=fork_panel_xc
DB_USERNAME=fork_panel_xc
DB_PASSWORD=change-me

# Redis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=null
REDIS_DB=0

# Session / cache / queue
SESSION_DRIVER=redis
SESSION_LIFETIME=120
CACHE_DRIVER=redis
QUEUE_CONNECTION=redis

# Mail
MAIL_MAILER=smtp
MAIL_HOST=localhost
MAIL_PORT=25
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS=noreply@localhost
MAIL_FROM_NAME="Fork Panel XC"

# Auth
JWT_SECRET=change-me-to-a-64-char-random-string
JWT_TTL=60
JWT_REFRESH_TTL=10080
APP_KEY=base64:change-me
STREAM_TOKEN_SECRET=change-me-to-a-64-char-random-string
STREAM_TOKEN_TTL=3600

# Media
FFMPEG_PATH=/usr/bin/ffmpeg
FFPROBE_PATH=/usr/bin/ffprobe

# TMDB metadata module (optional; can also be set in Settings → Modules)
TMDB_API_KEY=

# Paths
STORAGE_PATH=/home/fork_panel_xc/storage
CACHE_PATH=/home/fork_panel_xc/storage/cache
LOG_PATH=/home/fork_panel_xc/storage/logs
